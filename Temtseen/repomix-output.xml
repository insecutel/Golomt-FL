          <h2>Олгосон шагналууд (${list.length})</h2>
      ${list.length ? `
        <div class="table-wrap"><table>
          <thead><tr><th>Дүрс</th><th>Шагнал</th><th>Хүлээн авагч</th><th>👑 Эзэмшигч</th><th>Огноо</th><th></th></tr></thead>
